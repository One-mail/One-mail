# OneMail — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ============================================================================
# DATABASE
# ============================================================================
# PostgreSQL connection string (Neon, Supabase, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ============================================================================
# AUTH.JS (next-auth v5)
# See: https://authjs.dev/reference/nextjs#environment-variables
# ============================================================================

# Required: secret used to sign and encrypt Auth.js JWTs and cookies.
# Generate a new value with: npx auth secret
# Keep this value private. Rotate it to invalidate all existing sessions.
AUTH_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# Google OAuth 2.0 credentials
# Create at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google (dev)
AUTH_GOOGLE_ID=REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# ============================================================================
# PRODUCTION NOTES
# ============================================================================
# 1. gmail.readonly scope requires OAuth consent screen verification for
#    production release. See: https://support.google.com/cloud/answer/9110914
# 2. Tokens are stored in the Account table in plain text.
#    Enable Neon encryption-at-rest and consider column-level encryption
#    for production defence-in-depth.
# 3. Rotate AUTH_SECRET periodically. This invalidates all active sessions.